{
  "version": 2,
  "outputDirectory": "client/build",
  "buildCommand": "cd client && npm install && npm run build",
  "installCommand": "npm install",
  "api": {
    "server.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/server.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
